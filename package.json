{
  "name": "project-terra",
  "productName": "Project Terra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projected tabletop battle map for in-person D&D, run from the DM's laptop.",
  "main": "dist/main.cjs",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "npm run build && node --test \"e2e/*.test.mjs\"",
    "check": "npm run format:check && npm run typecheck && npm run knip && npm test",
    "dist:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "knip": "knip"
  },
  "build": {
    "appId": "com.ddraigfawr13.projectterra",
    "productName": "Project Terra",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
